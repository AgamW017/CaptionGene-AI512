# ---------------------------------------------------------------------------
# WasteCap environment variables
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# Backend to use for caption generation.
# Options: mock | blip2 | qwen_vl | llava
WASTECAP_BACKEND=mock

# Device for model inference.
# Options: cpu | cuda
WASTECAP_DEVICE=cpu

# Quantization level (applied when loading model weights).
# Options: none | 4bit | 8bit
WASTECAP_QUANTIZE=none

# Path to the SQLite database file.
# Default: data/db/wastecap.db (relative to project root)
WASTECAP_DB_PATH=data/db/wastecap.db

# Reviewer name written into annotation records.
# Change this on each machine / for each annotator.
WASTECAP_REVIEWER=annotator_1

# Path to the project configs directory.
# Default: configs/ (relative to project root)
WASTECAP_CONFIGS_DIR=configs

# Logging level: DEBUG | INFO | WARNING | ERROR
WASTECAP_LOG_LEVEL=INFO

# Docker / automation
# WASTECAP_PORT=8501
# INSTALL_ML=false
